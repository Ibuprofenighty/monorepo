# Staging example — copy to staging.env (gitignored), fill real values.
# NEVER commit the filled file.
POSTGRES_USER=project
POSTGRES_PASSWORD=change-me
POSTGRES_DB=project
DATABASE_URL=postgresql+asyncpg://project:change-me@postgres:5432/project
# begin capability:redis
REDIS_URL=redis://redis:6379/0
# end capability:redis
APP_ENV=staging
# begin identity:hs256
# >= 32 bytes; the API refuses to start without it.
JWT_SECRET=change-me
# end identity:hs256
# identity:env-file
NGINX_PORT=8080
WEB_APP=web
