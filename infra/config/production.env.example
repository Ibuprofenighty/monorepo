# Production example — values come from the secret manager, not git.
# NEVER commit the filled file.
POSTGRES_USER=project
POSTGRES_PASSWORD=${SECRET_POSTGRES_PASSWORD}
POSTGRES_DB=project
DATABASE_URL=${SECRET_DATABASE_URL}
REDIS_URL=${SECRET_REDIS_URL}
APP_ENV=production
# >= 32 bytes; the API refuses to start without it.
JWT_SECRET=${SECRET_JWT_SECRET}
NGINX_PORT=80
WEB_APP=web
