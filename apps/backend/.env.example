# Copy to .env (same dir). Never commit the real .env.
# APP_ENV=dev|test may use the built-in dev JWT secret; staging/production
# refuse to start unless JWT_SECRET is injected (>= 32 bytes).
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/project
# begin capability:redis
REDIS_URL=redis://localhost:6379/0
# end capability:redis
# identity:env-file
