# Copy to .env for local compose runs (`make dev`). .env is gitignored.
# Fill the empty values locally; never commit them.
COMPOSE_PROJECT_NAME=project
APP_ENV=dev
# Local database password for the compose postgres service.
POSTGRES_PASSWORD=
# begin identity:hs256
# >= 32 bytes, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=
# end identity:hs256
# identity:env-file
